# ── WhatsApp Cloud API ──────────────────────────
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v21.0

# ── LLM: NVIDIA API (chat / JSON completions) ───
# OpenAI-compatible gateway. Used for all chat + JSON extraction/scoring.
NVIDIA_API_KEY=your_nvidia_api_key
# Optional per-model overrides (default to meta/muse-glimmer-30b via NVIDIA API):
# CHAT_MODEL=meta/muse-glimmer-30b
# EXTRACTION_MODEL=meta/muse-glimmer-30b
# SCORING_MODEL=meta/muse-glimmer-30b

# ── OpenAI (OPTIONAL) ───────────────────────────
# OpenRouter has NO Whisper or embeddings. Set this only to enable voice-note
# transcription + semantic memory. Without it those degrade gracefully.
# OPENAI_API_KEY=your_openai_api_key

# ── Supabase ────────────────────────────────────
# The backend authenticates with the SECRET key (sb_secret_... / service_role).
# RLS is ON with no policies, so the publishable/anon key is blocked from every
# table — do NOT put the publishable key in SUPABASE_KEY.
#
# Easiest setup: fill SUPABASE_PROJECT_REF + SUPABASE_ACCESS_TOKEN below, then:
#     python3 scripts/supabase_bootstrap.py
# That reveals the secret key into SUPABASE_KEY and applies supabase/migrations/*.
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=                       # leave blank; the bootstrap script fills it
                                    # (or paste the sb_secret_... key yourself)

# Bootstrap / Management-API only (not read at runtime) ──
SUPABASE_PROJECT_REF=your_project_ref          # the "xxxx" in xxxx.supabase.co
SUPABASE_ACCESS_TOKEN=sbp_your_pat             # Personal Access Token — ROTATE after setup
# Publishable/anon key — NOT used by the backend; kept only for a future browser client:
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── App ─────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
